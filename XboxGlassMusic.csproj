      - name: Build and package x64
        shell: pwsh
        run: |
          $out = "$env:GITHUB_WORKSPACE\artifacts"
          New-Item -ItemType Directory -Force -Path $out | Out-Null

          msbuild "${{ steps.project.outputs.solution }}" `
            /t:Restore `
            /p:Configuration=Release `
            /p:Platform=x64 `
            /v:minimal

          if ($LASTEXITCODE -ne 0) {
            throw "NuGet restore failed with exit code $LASTEXITCODE"
          }

          msbuild "${{ steps.project.outputs.solution }}" `
            /t:Build `
            /m `
            /p:Configuration=Release `
            /p:Platform=x64 `
            /p:AppxBundle=Never `
            /p:UapAppxPackageBuildMode=SideloadOnly `
            /p:AppxPackageSigningEnabled=true `
            /p:PackageCertificateKeyFile="$env:RUNNER_TEMP\signing.pfx" `
            /p:PackageCertificatePassword="TemporaryBuildPassword123!" `
            /p:AppxPackageDir="$out\\" `
            /v:minimal

          if ($LASTEXITCODE -ne 0) {
            throw "MSBuild failed with exit code $LASTEXITCODE"
          }

          Copy-Item "$env:RUNNER_TEMP\signing.cer" `
            "$out\XboxGlassMusic-signing.cer"

          Get-ChildItem $out -Recurse
