<Page
    x:Class="XboxGlassMusic.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B0D13"
    Loaded="Page_Loaded">
  <Page.Resources>
    <LinearGradientBrush x:Key="Backdrop" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF172D36" Offset="0"/>
      <GradientStop Color="#FF15142D" Offset="0.52"/>
      <GradientStop Color="#FF080A10" Offset="1"/>
    </LinearGradientBrush>
  </Page.Resources>
  <Grid Background="{StaticResource Backdrop}">
    <Ellipse Width="650" Height="650" Fill="#4425D9A2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-300,0,0"/>
    <Ellipse Width="620" Height="620" Fill="#443C55D9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-320"/>
    <Grid Padding="44,32">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,26">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="48" Height="48" CornerRadius="14" Background="#FF1ED760">
            <TextBlock Text="♫" Foreground="#FF07110B" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="XboxGlassMusic" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Text="YOUR SOUND. YOUR SPACE." FontSize="11" CharacterSpacing="180" Foreground="#AFFFFFFF"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button x:Name="OpenButton" Content="＋  Open audio" Click="OpenButton_Click"/>
          <Button Content="Spotify ↗" Click="SpotifyButton_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" CornerRadius="28" BorderBrush="#66FFFFFF" BorderThickness="1" Background="#22FFFFFF" Padding="28" Margin="0,0,20,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Border CornerRadius="22" Clip="True" Background="#FF192C32" BorderBrush="#44FFFFFF" BorderThickness="1">
                <Grid>
                  <Ellipse Width="340" Height="340" Fill="#FF1ED760" Opacity="0.28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Ellipse Width="250" Height="250" Fill="#FF4C7DDB" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Ellipse Width="160" Height="160" Fill="#FF141923" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Ellipse Width="110" Height="110" Fill="#FF1ED760" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock Text="♫" FontSize="86" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1" Margin="4,22,4,0">
                <TextBlock Text="NOW PLAYING" FontSize="12" CharacterSpacing="200" Foreground="#FF1ED760"/>
                <TextBlock x:Name="TrackTitle" Text="Choose your first track" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                <TextBlock x:Name="TrackArtist" Text="Your local library" FontSize="18" Foreground="#BFFFFFFF" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
              <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0" IsEnabled="False"/>
              <Grid Margin="0,4,0,0">
                <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#AFFFFFFF"/>
                <TextBlock x:Name="DurationText" Text="0:00" Foreground="#AFFFFFFF" HorizontalAlignment="Right"/>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Margin="0,18,0,0">
                <Button Content="⏮" Click="PreviousButton_Click" FontSize="24" MinWidth="64"/>
                <Button x:Name="PlayButton" Content="▶" Click="PlayButton_Click" FontSize="28" MinWidth="76" Background="#FF1ED760" Foreground="#FF07110B"/>
                <Button Content="⏭" Click="NextButton_Click" FontSize="24" MinWidth="64"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="8,0,0,18">
            <TextBlock Text="A little atmosphere." FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="A calmer way to soundtrack your session." FontSize="17" Foreground="#BFFFFFFF" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="22" Background="#28FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="22" Margin="0,0,10,12">
              <StackPanel>
                <TextBlock Text="YOUR LIBRARY" Foreground="#FF1ED760" FontSize="12" CharacterSpacing="150"/>
                <TextBlock Text="Local audio" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock Text="Pick tracks stored somewhere your Xbox app can access." TextWrapping="Wrap" Foreground="#BFFFFFFF" FontSize="16"/>
                <Button Content="Browse files  →" Click="OpenButton_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="22" Background="#28FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="22" Margin="10,0,0,12">
              <StackPanel>
                <TextBlock Text="CONNECTIVITY" Foreground="#FF91A7FF" FontSize="12" CharacterSpacing="150"/>
                <TextBlock Text="Spotify" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock Text="Explore authorized account and playback options. Custom Spotify streaming is not wired into this starter." TextWrapping="Wrap" Foreground="#BFFFFFFF" FontSize="16"/>
                <Button Content="Spotify developer docs  ↗" Click="SpotifyButton_Click" HorizontalAlignment="Left" Margin="0,20,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="2" CornerRadius="18" Background="#1EFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Ellipse Width="9" Height="9" Fill="#FF1ED760" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Text="Ready · Open an audio file to begin" Foreground="#DFFFFFFF" FontSize="15" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid Grid.Row="2" Margin="0,20,0,0">
        <TextBlock Text="DESIGNED FOR THE BIG SCREEN" FontSize="11" CharacterSpacing="180" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
        <TextBlock Text="A / Enter  Select     B / Esc  Back     D-pad  Navigate" FontSize="13" Foreground="#88FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Grid>
</Page>
