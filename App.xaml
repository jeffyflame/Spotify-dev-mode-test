<Application
    x:Class="XboxGlassMusic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="AccentBrush" Color="#FF1ED760"/>
      <SolidColorBrush x:Key="GlassFill" Color="#28FFFFFF"/>
      <SolidColorBrush x:Key="GlassStroke" Color="#55FFFFFF"/>
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#24FFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
